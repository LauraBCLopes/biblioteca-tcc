# Variáveis de ambiente do banco de dados.
#
# Isto é só documentação — o PHP não lê arquivos .env automaticamente.
# Em produção (Vercel), configure estas mesmas chaves em:
#   Project Settings → Environment Variables
# usando os dados de conexão do Supabase (Session pooler, porta 5432 —
# necessário porque o sistema usa transações com SELECT ... FOR UPDATE).
#
# Localmente (XAMPP/Laragon), NÃO defina nada — o config/database.php já
# cai nos padrões de desenvolvimento (mysql / root / senha vazia) quando
# estas variáveis não existem.

DB_DRIVER=pgsql
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASS=

# Projeto Supabase em us-east-1 (não sa-east-1) de propósito: a função
# serverless da Vercel roda em iad1 (Virgínia, EUA) mesmo no plano Hobby
# com o projeto configurado pra região "gru1" — colocar o banco na mesma
# região da função elimina a viagem EUA<->Brasil em toda query.
